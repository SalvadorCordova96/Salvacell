{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/*": [
        "./frontend/components/*"
      ],
      "@/lib/*": [
        "./frontend/lib/*"
      ],
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    "**/*.mts",
    ".next-verify-e2e/types/**/*.ts",
    ".next-verify-e2e/dev/types/**/*.ts",
    ".next-ux-current-e2e-20261022/types/**/*.ts",
    ".next-ux-current-e2e-20261022/dev/types/**/*.ts",
    ".next-qr-restore-20261022/types/**/*.ts",
    ".next-qr-restore-20261022/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples"
  ]
}
